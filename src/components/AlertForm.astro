---
// Configuration proposable dans le menu de la page modèle (une seule alerte
// possible par envoi ; l'API reçoit toujours famille + état + version).
interface AlertConfig {
  edition: string;
  version: string;
  label: string; // libellé affiché dans le menu, ex. "Neuf — Digital"
  modelName: string; // libellé du produit utilisé dans les e-mails, ex. "PS5 Neuf Digital"
  price: number; // prix actuel, pour suggérer un prix cible
}

interface Props {
  modelName: string;
  currentPrice: number;
  familySlug: string;
  edition: string;
  version: string;
  // Optionnel : sans cette prop le formulaire se comporte exactement comme
  // avant (une seule configuration, fixée par les props ci-dessus).
  configs?: AlertConfig[];
  // Page modèle : la configuration visée suit le sélecteur État / Version de la
  // page (panneau visible `[data-config-panel]`) au lieu d'un menu déroulant.
  followSelection?: boolean;
}

const { modelName, currentPrice, familySlug, edition, version, configs, followSelection = false } = Astro.props;
const showConfigSelect = Boolean(configs && configs.length > 1 && !followSelection);
const showConfigValue = Boolean(configs && configs.length > 0 && followSelection);
const initialConfigLabel = configs?.find((c) => c.edition === edition && c.version === version)?.label ?? "";
const suggestedTarget = Math.round((currentPrice * 0.9) / 10) * 10;
---

<div class="alert-form card" data-family={familySlug} data-edition={edition} data-version={version} data-product-label={modelName} data-follow-selection={followSelection ? "true" : undefined}>
  <p class="alert-form__title">Créer une alerte</p>

  {showConfigSelect && configs && (
    <div class="alert-form__row alert-form__row--config">
      <label for="alert-config" class="alert-form__label">Configuration concernée</label>
      <div class="alert-form__input-wrap alert-form__input-wrap--full">
        <select id="alert-config" name="alert-config" class="alert-form__select">
          {configs.map((c) => (
            <option
              value={`${c.edition}-${c.version}`}
              data-edition={c.edition}
              data-version={c.version}
              data-model-name={c.modelName}
              data-price={c.price}
              selected={c.edition === edition && c.version === version}
            >
              {c.label}
            </option>
          ))}
        </select>
      </div>
    </div>
  )}

  {showConfigValue && (
    <div class="alert-form__row alert-form__row--config">
      <label for="alert-config" class="alert-form__label">Configuration concernée</label>
      <output id="alert-config" class="alert-form__config-value" data-config-value>{initialConfigLabel}</output>
    </div>
  )}

  <div class="alert-form__type-toggle" role="tablist" aria-label="Type d'alerte">
    <button type="button" class="alert-form__type-option is-active" data-type="price" role="tab" aria-selected="true">
      Baisse de prix
    </button>
    <button type="button" class="alert-form__type-option" data-type="stock" role="tab" aria-selected="false">
      Retour en stock
    </button>
  </div>

  <p class="alert-form__subtitle" data-subtitle-for="price">
    Préviens-moi par email lorsque la <span data-model-name-slot>{modelName}</span> passe sous un certain prix.
  </p>
  <p class="alert-form__subtitle" data-subtitle-for="stock" hidden>
    Préviens-moi par email dès que la <span data-model-name-slot>{modelName}</span> revient en stock chez un marchand.
  </p>

  <div class="alert-form__row">
    <label for="alert-email" class="alert-form__label">Ton email</label>
    <div class="alert-form__input-wrap alert-form__input-wrap--full">
      <input type="email" id="alert-email" name="email" placeholder="toi@exemple.com" required />
    </div>
  </div>

  <div class="alert-form__row" data-row-for="price">
    <label for="target-price" class="alert-form__label">Prix cible</label>
    <div class="alert-form__input-wrap">
      <input
        type="number"
        id="target-price"
        name="target-price"
        value={suggestedTarget}
        min="0"
        step="10"
      />
      <span aria-hidden="true">€</span>
    </div>
  </div>

  <button type="button" class="button button--primary alert-form__submit" id="alert-submit">Créer l'alerte</button>
  <p class="alert-form__note" id="alert-note">Tu recevras un email dès que ce prix est atteint.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".alert-form").forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>(".alert-form__submit");
    const note = form.querySelector<HTMLElement>(".alert-form__note");
    const emailInput = form.querySelector<HTMLInputElement>("#alert-email");
    const priceInput = form.querySelector<HTMLInputElement>("#target-price");
    const priceRow = form.querySelector<HTMLElement>('[data-row-for="price"]');
    const typeButtons = form.querySelectorAll<HTMLButtonElement>(".alert-form__type-option");
    const subtitles = form.querySelectorAll<HTMLElement>("[data-subtitle-for]");

    let currentType: "price" | "stock" = "price";

    const defaultNotes: Record<"price" | "stock", string> = {
      price: "Tu recevras un email dès que ce prix est atteint.",
      stock: "Tu recevras un email dès que ce produit est de nouveau disponible.",
    };

    typeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentType = btn.dataset.type === "stock" ? "stock" : "price";

        typeButtons.forEach((b) => {
          b.classList.toggle("is-active", b === btn);
          b.setAttribute("aria-selected", String(b === btn));
        });

        subtitles.forEach((s) => {
          s.hidden = s.dataset.subtitleFor !== currentType;
        });

        if (priceRow) priceRow.hidden = currentType !== "price";
        if (note) {
          note.style.color = "";
          note.textContent = defaultNotes[currentType];
        }
      });
    });

    // Menu de configuration (page modèle) : met à jour la variante visée par
    // l'alerte. Les valeurs sont relues au clic sur « Créer l'alerte », donc
    // l'appel à /api/alerts/create reste strictement identique.
    const configSelect = form.querySelector<HTMLSelectElement>(".alert-form__select");
    const modelSlots = form.querySelectorAll<HTMLElement>("[data-model-name-slot]");
    let priceEdited = false;
    let locked = false; // alerte déjà enregistrée : la configuration ne bouge plus

    priceInput?.addEventListener("input", () => {
      priceEdited = true;
    });

    // Page modèle (mode `followSelection`) : la configuration visée est celle du
    // panneau actuellement affiché par le sélecteur État / Version. On lit le DOM
    // à l'initialisation ET à chaque changement, donc l'ordre d'exécution des
    // scripts n'a pas d'importance. Le payload de /api/alerts/create ne change pas.
    const configValue = form.querySelector<HTMLElement>("[data-config-value]");

    const syncFromSelection = () => {
      if (locked || form.dataset.followSelection !== "true") return;

      const panel = document.querySelector<HTMLElement>("[data-config-panel]:not([hidden])");
      if (!panel) return;

      form.dataset.edition = panel.dataset.edition ?? "";
      form.dataset.version = panel.dataset.version ?? "";
      form.dataset.productLabel = panel.dataset.modelName ?? "";
      if (configValue) configValue.textContent = panel.dataset.label ?? "";
      modelSlots.forEach((slot) => {
        slot.textContent = panel.dataset.modelName ?? "";
      });

      const price = Number(panel.dataset.price);
      if (priceInput && !priceEdited && price > 0) {
        priceInput.value = String(Math.round((price * 0.9) / 10) * 10);
      }
    };

    document.addEventListener("tracko:config-change", syncFromSelection);
    syncFromSelection();

    configSelect?.addEventListener("change", () => {
      const option = configSelect.selectedOptions[0];
      if (!option) return;

      form.dataset.edition = option.dataset.edition ?? "";
      form.dataset.version = option.dataset.version ?? "";
      form.dataset.productLabel = option.dataset.modelName ?? "";
      modelSlots.forEach((slot) => {
        slot.textContent = option.dataset.modelName ?? "";
      });

      const price = Number(option.dataset.price);
      if (priceInput && !priceEdited && price > 0) {
        priceInput.value = String(Math.round((price * 0.9) / 10) * 10);
      }
    });

    button?.addEventListener("click", async () => {
      if (!button || !note || !emailInput) return;

      const email = emailInput.value.trim();

      if (!email || !email.includes("@")) {
        note.textContent = "Entre une adresse email valide.";
        note.style.color = "var(--color-tres-cher-text)";
        return;
      }

      let targetPrice: number | undefined;
      if (currentType === "price") {
        targetPrice = Number(priceInput?.value);
        if (!targetPrice || targetPrice <= 0) {
          note.textContent = "Entre un prix cible valide.";
          note.style.color = "var(--color-tres-cher-text)";
          return;
        }
      }

      button.disabled = true;
      button.textContent = "Création...";
      note.style.color = "";
      note.textContent = "";

      try {
        const response = await fetch("/api/alerts/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            type: currentType,
            email,
            targetPrice,
            familySlug: form.dataset.family,
            edition: form.dataset.edition,
            version: form.dataset.version,
            productLabel: form.dataset.productLabel,
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Une erreur est survenue.");
        }

        button.textContent = "Alerte enregistrée ✓";
        note.textContent = "Vérifie ta boîte mail pour la confirmation.";
        locked = true;
        emailInput.disabled = true;
        if (priceInput) priceInput.disabled = true;
        typeButtons.forEach((b) => (b.disabled = true));
        if (configSelect) configSelect.disabled = true;
      } catch (err) {
        button.disabled = false;
        button.textContent = "Créer l'alerte";
        note.style.color = "var(--color-tres-cher-text)";
        note.textContent = err instanceof Error ? err.message : "Une erreur est survenue, réessaie.";
      }
    });
  });
</script>

<style>
  .alert-form {
    padding: 20px;
  }

  .alert-form__title {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .alert-form__type-toggle {
    display: flex;
    gap: 4px;
    width: fit-content;
    margin-bottom: 14px;
    padding: 3px;
    border-radius: var(--radius-control);
    background: var(--color-surface-muted);
  }

  .alert-form__type-option {
    padding: 7px 12px;
    border: 0;
    border-radius: calc(var(--radius-control) - 3px);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }

  .alert-form__type-option:hover {
    color: var(--color-text-primary);
  }

  .alert-form__type-option.is-active {
    background: var(--color-surface);
    color: var(--color-text-primary);
    box-shadow: 0 1px 3px rgba(23, 22, 17, 0.08);
  }

  .alert-form__subtitle {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .alert-form__row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .alert-form__label {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .alert-form__input-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    padding: 8px 12px;
    width: fit-content;
  }

  .alert-form__input-wrap--full {
    width: 100%;
  }

  .alert-form__input-wrap input {
    border: none;
    outline: none;
    font-size: 14px;
    width: 90px;
    font-family: var(--font-sans);
  }

  .alert-form__input-wrap--full input {
    width: 100%;
  }

  .alert-form__config-value {
    display: block;
    width: 100%;
    padding: 8px 12px;
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-surface-muted);
    color: var(--color-text-primary);
    font-size: 14px;
    font-weight: 600;
  }

  .alert-form__select {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 14px;
    cursor: pointer;
  }

  .alert-form__submit {
    width: 100%;
  }

  .alert-form__note {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-top: 10px;
    text-align: center;
    min-height: 16px;
  }
</style>
