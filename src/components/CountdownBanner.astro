---
import { gtaBannerConfig } from "../data/gta-config";
---

<!--
  Ce bloc est un EMPLACEMENT pour ton bandeau. Le fond (image/illustration
  complète GTA VI) est à toi de l'ajouter — voir gta-config.ts pour le chemin
  d'image attendu (bannerImagePath). Tant que le fichier n'existe pas encore,
  l'emplacement neutre avec un repère visuel reste affiché à la place (le
  onerror ci-dessous retire l'image proprement si elle ne charge pas).
  Le compte à rebours reste toujours affiché en incrustation, en haut à droite.
-->
<div class="countdown-banner-wrap">
  <a
    class="countdown-banner"
    href={gtaBannerConfig.preorderUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Précommander GTA VI sur le site officiel Rockstar Games"
  >
    <div class="countdown-banner__placeholder-label">
      Emplacement bandeau — voir src/data/gta-config.ts
    </div>

    {gtaBannerConfig.bannerImagePath && (
      <img
        class="countdown-banner__image"
        src={gtaBannerConfig.bannerImagePath}
        alt=""
        loading="lazy"
        decoding="async"
        onerror="this.remove(); this.closest('.countdown-banner')?.classList.add('countdown-banner--empty');"
      />
    )}

    <div class="countdown-banner__timer" data-release={gtaBannerConfig.releaseDateISO}>
      <p class="countdown-banner__timer-label">Sortie dans</p>
      <div class="countdown-banner__units">
        <div class="countdown-banner__unit">
          <span class="countdown-banner__value" data-unit="days">--</span>
          <span class="countdown-banner__unit-label">j</span>
        </div>
        <div class="countdown-banner__unit">
          <span class="countdown-banner__value" data-unit="hours">--</span>
          <span class="countdown-banner__unit-label">h</span>
        </div>
        <div class="countdown-banner__unit">
          <span class="countdown-banner__value" data-unit="minutes">--</span>
          <span class="countdown-banner__unit-label">m</span>
        </div>
        <div class="countdown-banner__unit">
          <span class="countdown-banner__value" data-unit="seconds">--</span>
          <span class="countdown-banner__unit-label">s</span>
        </div>
      </div>
    </div>
  </a>

  <a
    class="gta-preorder-btn"
    href={gtaBannerConfig.preorderUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    Précommander GTA VI →
  </a>
</div>

<script>
  function tick() {
    document.querySelectorAll<HTMLElement>("[data-release]").forEach((el) => {
      const release = new Date(el.dataset.release!).getTime();
      const now = Date.now();
      const diff = Math.max(release - now, 0);

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      const set = (unit: string, value: number) => {
        const target = el.querySelector<HTMLElement>(`[data-unit="${unit}"]`);
        if (target) target.textContent = String(value).padStart(2, "0");
      };

      set("days", days);
      set("hours", hours);
      set("minutes", minutes);
      set("seconds", seconds);
    });
  }

  tick();
  setInterval(tick, 1000);
</script>

<style>
  .countdown-banner-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .countdown-banner {
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: #14140f;

    /* Cadre maîtrisé : le bandeau reste un vrai conteneur borné (largeur
       et hauteur), il ne s'étend plus en pleine largeur du viewport.
       L'image est contenue dedans via object-fit: cover (voir plus bas),
       avec une hauteur toujours comprise entre 200px et 360px, quelle
       que soit la largeur de l'écran, pour éviter tout débordement. */
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    aspect-ratio: 2.55 / 1;
    min-height: 176px;
    max-height: 320px;
  }

  .gta-preorder-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 17px;
    border-radius: 999px;
    border: 0.5px solid var(--color-border-strong);
    color: var(--color-text-primary);
    transition: background var(--dur-fast) var(--ease-premium), border-color var(--dur-fast) var(--ease-premium), transform var(--dur-fast) var(--ease-premium);
  }

  .gta-preorder-btn:hover {
    background: var(--color-surface-muted);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  /* Tant qu'aucune image ne charge, le bandeau se réduit et se centre —
     il repasse automatiquement au format ci-dessus dès qu'un visuel valide
     est déposé dans /public/images/ (voir gta-config.ts). */
  .countdown-banner.countdown-banner--empty {
    aspect-ratio: unset;
    min-height: 0;
    max-height: none;
    height: auto;
    max-width: min(700px, 88%);
    margin: 0 auto;
    padding: 28px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background-color: var(--color-surface-muted);
  }

  .countdown-banner--empty .countdown-banner__placeholder-label {
    position: static;
    inset: auto;
    margin: 0;
    padding: 0;
    border: none;
    color: var(--color-text-muted);
  }

  .countdown-banner--empty .countdown-banner__timer {
    position: static;
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    padding: 0;
    color: var(--color-text-primary);
  }

  .countdown-banner--empty .countdown-banner__timer-label {
    color: var(--color-text-muted);
  }

  .countdown-banner--empty .countdown-banner__unit-label {
    color: var(--color-text-muted);
  }

  .countdown-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    animation: banner-breathe 16s ease-in-out infinite alternate;
  }

  @keyframes banner-breathe {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .countdown-banner__image {
      animation: none;
    }
  }

  .countdown-banner__placeholder-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    font-size: 12px;
    color: rgba(250, 249, 246, 0.4);
    border: 1px dashed rgba(250, 249, 246, 0.2);
    border-radius: var(--radius-card);
    margin: 8px;
  }

  .countdown-banner__timer {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(10, 10, 8, 0.58);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius-control);
    padding: 9px 13px;
    color: #faf9f6;
  }

  .countdown-banner__timer-label {
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(250, 249, 246, 0.65);
    margin-bottom: 5px;
    text-align: center;
  }

  .countdown-banner__units {
    display: flex;
    gap: 10px;
  }

  .countdown-banner__unit {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .countdown-banner__value {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .countdown-banner__unit-label {
    font-size: 11px;
    color: rgba(250, 249, 246, 0.55);
  }

  @media (max-width: 640px) {
    .countdown-banner-wrap {
      gap: 10px;
    }

    .countdown-banner__timer {
      top: 10px;
      right: 10px;
      padding: 7px 10px;
    }

    .countdown-banner__timer-label {
      font-size: 8.5px;
      margin-bottom: 3px;
    }

    .countdown-banner__units {
      gap: 7px;
    }

    .countdown-banner__value {
      font-size: 14px;
    }

    .countdown-banner__unit-label {
      font-size: 9.5px;
    }

    .gta-preorder-btn {
      width: calc(100% - 40px);
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .countdown-banner__timer {
      top: 8px;
      right: 8px;
      padding: 5px 8px;
    }

    .countdown-banner__timer-label {
      font-size: 7.5px;
      margin-bottom: 2px;
      letter-spacing: 0.04em;
    }

    .countdown-banner__units {
      gap: 5px;
    }

    .countdown-banner__unit {
      gap: 1px;
    }

    .countdown-banner__value {
      font-size: 11px;
    }

    .countdown-banner__unit-label {
      font-size: 8px;
    }

    .gta-preorder-btn {
      width: calc(100% - 32px);
    }
  }
</style>
