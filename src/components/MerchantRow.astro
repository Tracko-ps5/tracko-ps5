---
import type { Merchant } from "../data/mock-ps5";

interface Props {
  merchant: Merchant;
  isBest: boolean;
}

const { merchant, isBest } = Astro.props;

const formattedDate = new Date(merchant.updatedAt).toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "short",
});

/*
 * Logos marchands.
 *
 * Les quatre premiers utilisaient déjà des ressources
 * qui fonctionnaient dans TRACKO.
 *
 * Boulanger utilise maintenant son logo officiel
 * hébergé sur son CDN officiel.
 *
 * PlayStation est préparé pour une future intégration.
 *
 * Easy Cash est préparé pour une future intégration : le favicon officiel
 * de easycash.fr, même mécanisme que Amazon/Fnac/Cdiscount/Back Market/
 * PlayStation. N'apparaît que si une offre Easy Cash existe réellement
 * dans les données (voir data/mock-ps5.ts et lib/live-data.ts).
 */
const merchantLogos: Record<string, string> = {
  amazon: "https://www.amazon.fr/favicon.ico",

  fnac: "https://www.fnac.com/favicon.ico",

  cdiscount: "https://www.cdiscount.com/favicon.ico",

  boulanger:
    "https://boulanger.scene7.com/is/image/Boulanger/LOGO2%20boulsign%20boulanger%20RVB?fmt=png-alpha",

  backmarket: "https://www.backmarket.fr/favicon.ico",

  playstation: "https://www.playstation.com/favicon.ico",

  easycash: "https://www.easycash.fr/favicon.ico",
};

/*
 * Normalisation du nom du marchand.
 */
const normalizedName = merchant.name
  .toLowerCase()
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .replace(/[^a-z0-9]/g, "");

const merchantAliases: Record<string, string> = {
  amazonfr: "amazon",
  amazoncom: "amazon",

  fnaccom: "fnac",
  fnacfr: "fnac",

  cdiscountcom: "cdiscount",
  cdiscountfr: "cdiscount",

  boulangercom: "boulanger",
  boulangerfr: "boulanger",

  backmarketfr: "backmarket",
  backmarketcom: "backmarket",

  playstationcom: "playstation",
  playstationfr: "playstation",

  easycashfr: "easycash",
  easycashcom: "easycash",
};

const merchantKey =
  merchantAliases[normalizedName] ?? normalizedName;

const merchantLogo = merchantLogos[merchantKey] ?? null;

/*
 * Initiale utilisée uniquement si un marchand inconnu
 * est ajouté plus tard et qu'aucun logo n'est défini.
 */
const merchantInitial =
  merchant.name.trim().charAt(0).toUpperCase();
---

<div class:list={["merchant-card", isBest && "merchant-card--best"]}>
  {isBest && (
    <span class="merchant-card__ribbon">
      Meilleur prix
    </span>
  )}

  <div class="merchant-card__top">
    {merchantLogo ? (
      <div class="merchant-card__logo-container">
        <img
          class="merchant-card__logo"
          src={merchantLogo}
          alt=""
          width={isBest ? "36" : "28"}
          height={isBest ? "36" : "28"}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          aria-hidden="true"
        />
      </div>
    ) : (
      <div
        class="merchant-card__fallback"
        aria-hidden="true"
      >
        {merchantInitial}
      </div>
    )}

    <div class="merchant-card__identity">
      <p class="merchant-card__name-text">
        {merchant.name}
      </p>

      <div
        class="merchant-card__stars"
        aria-label={`Note de confiance : ${merchant.trustRating} sur 5`}
      >
        {Array.from({ length: 5 }).map((_, i) => (
          <span
            class={i < merchant.trustRating ? "is-filled" : ""}
            aria-hidden="true"
          >
            ★
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="merchant-card__meta">
    <span class={`merchant-card__availability ${merchant.available ? "" : "merchant-card__availability--out"}`}>
      {merchant.available ? "En stock" : "Indisponible"}
    </span>

    <span class="merchant-card__updated">
      Màj {formattedDate}
    </span>
  </div>

  <div class="merchant-card__price-row">
    <span class="merchant-card__price">{merchant.price} €</span>
  </div>

  <a
    class:list={[
      "button",
      "merchant-card__cta",
      isBest && merchant.available && "button--primary",
      !merchant.available && "button--disabled",
    ]}
    href={merchant.available ? merchant.url : undefined}
    aria-disabled={!merchant.available}
    tabindex={merchant.available ? undefined : -1}
  >
    Voir l'offre
  </a>
</div>

<style>
  .merchant-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 16px;
    background: var(--color-surface);
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-card);
    transition:
      border-color 220ms var(--ease-premium),
      box-shadow 220ms var(--ease-premium);
  }

  .merchant-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 10px 24px -18px rgba(23, 22, 17, 0.22);
  }

  /* ─────────────────────────────────────────
     MEILLEUR PRIX — carte mise en avant
  ───────────────────────────────────────── */

  .merchant-card--best {
    order: -1;
    grid-column: 1 / -1;
    gap: 14px;
    padding: 22px 24px;
    border: 1px solid var(--color-accent);
    box-shadow: 0 16px 34px -20px rgba(27, 42, 74, 0.35);
  }

  @media (min-width: 561px) {
    .merchant-card--best {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }

    .merchant-card--best .merchant-card__top {
      flex: 1 1 220px;
    }

    .merchant-card--best .merchant-card__meta {
      flex: 0 0 auto;
    }

    .merchant-card--best .merchant-card__price-row {
      flex: 0 0 auto;
      margin-left: auto;
    }
  }

  .merchant-card__ribbon {
    position: absolute;
    top: 8px;
    left: 20px;
    display: inline-flex;
    align-items: center;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-text);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    box-shadow: 0 4px 10px -3px rgba(27, 42, 74, 0.5);
  }

  /* ─────────────────────────────────────────
     LOGO / IDENTITÉ
  ───────────────────────────────────────── */

  .merchant-card__top {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .merchant-card__identity {
    min-width: 0;
  }

  /*
   * Conteneur fixe pour tous les logos.
   * Cela garantit que chaque marchand occupe exactement
   * le même espace et évite tout décalage vertical.
   */
  .merchant-card__logo-container,
  .merchant-card__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .merchant-card--best .merchant-card__logo-container,
  .merchant-card--best .merchant-card__fallback {
    width: 36px;
    height: 36px;
    flex-basis: 36px;
  }

  .merchant-card__logo-container {
    background: transparent;
  }

  .merchant-card__logo {
    display: block;
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    border: 0;
    outline: none;
    object-fit: contain;
    object-position: center;
  }

  .merchant-card--best .merchant-card__logo {
    width: 36px;
    height: 36px;
  }

  /*
   * Fallback uniquement pour un éventuel nouveau marchand
   * qui ne possède pas encore de logo dans merchantLogos.
   */
  .merchant-card__fallback {
    border-radius: 7px;
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 600;
  }

  .merchant-card__name-text {
    margin: 0 0 2px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .merchant-card--best .merchant-card__name-text {
    font-size: 15px;
    font-weight: 600;
  }

  /*
   * Bloc étoiles strictement dimensionné.
   * Aucun espace ou élément supplémentaire sous le logo.
   */
  .merchant-card__stars {
    display: flex;
    align-items: center;
    width: max-content;
    height: 12px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    line-height: 12px;
    letter-spacing: 1px;
    color: var(--color-border-strong);
    white-space: nowrap;
  }

  .merchant-card__stars .is-filled {
    color: #c9a227;
  }

  /* ─────────────────────────────────────────
     DISPONIBILITÉ / MÀJ
  ───────────────────────────────────────── */

  .merchant-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .merchant-card__availability {
    color: var(--color-tier-bon-text);
    font-weight: 600;
  }

  .merchant-card__availability--out {
    color: var(--color-tres-cher-text);
  }

  .merchant-card__updated {
    color: var(--color-text-muted);
  }

  /* ─────────────────────────────────────────
     PRIX / BADGE / CTA
  ───────────────────────────────────────── */

  .merchant-card__price-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .merchant-card__price {
    font-weight: 600;
    font-size: 16px;
    color: var(--color-text-primary);
  }

  .merchant-card--best .merchant-card__price {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .merchant-card__cta {
    width: 100%;
    justify-content: center;
  }

  .merchant-card--best .merchant-card__cta {
    width: auto;
    padding: 12px 22px;
    font-size: 15px;
    font-weight: 600;
  }

  @media (min-width: 561px) {
    .merchant-card__cta {
      width: auto;
    }
  }

  /* Offre indisponible : bouton visuellement désactivé, sans changer le
     calcul du meilleur prix (géré ailleurs, côté [family].astro). */
  .button--disabled,
  .merchant-card a[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 560px) {
    .merchant-card {
      padding: 14px;
    }

    .merchant-card--best {
      padding: 20px 18px;
    }

    .merchant-card__logo-container,
    .merchant-card__fallback,
    .merchant-card__logo {
      width: 26px;
      height: 26px;
      flex-basis: 26px;
    }

    .merchant-card--best .merchant-card__logo-container,
    .merchant-card--best .merchant-card__fallback,
    .merchant-card--best .merchant-card__logo {
      width: 32px;
      height: 32px;
      flex-basis: 32px;
    }

    .merchant-card--best .merchant-card__price {
      font-size: 24px;
    }
  }
</style>



