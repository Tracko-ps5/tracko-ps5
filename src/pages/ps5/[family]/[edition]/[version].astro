---
// ANCIENNE URL : /ps5/[famille]/[état]/[version]
//
// Ces pages ont été fusionnées dans la page du modèle (/ps5/[famille]), qui
// affiche directement toutes les offres. On garde volontairement cette route
// pour que les anciennes URLs (déjà connues de Google/Bing, présentes dans les
// e-mails d'alerte déjà envoyés) répondent par une VRAIE redirection HTTP 301
// permanente vers la bonne section de la page modèle, par exemple :
//   /ps5/ps5/neuf/digital  →  /ps5/ps5#neuf-digital
//
// Ne pas supprimer cette route : elle doit rester en place durablement.
// Les combinaisons qui n'ont jamais existé (ex. ps5-pro/neuf/lecteur)
// continuent de répondre 404, comme avant.
export const prerender = false;
import { getFamily, versionsForFamily } from "../../../../data/mock-ps5";

const { family: familySlug, edition, version } = Astro.params;
const family = getFamily(familySlug ?? "");

const validEditions = ["neuf", "reconditionne"];
const isKnownVariant =
  family !== undefined &&
  validEditions.includes(edition ?? "") &&
  (versionsForFamily(family.slug) as string[]).includes(version ?? "");

if (!family || !isKnownVariant) {
  return new Response(null, { status: 404 });
}

return Astro.redirect(`/ps5/${family.slug}#${edition}-${version}`, 301);
---
