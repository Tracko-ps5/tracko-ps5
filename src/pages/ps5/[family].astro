---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ConsoleIllustration from "../../components/ConsoleIllustration.astro";
import MerchantRow from "../../components/MerchantRow.astro";
import AlertForm from "../../components/AlertForm.astro";
import { getFamily, priceLevelLabel, versionLabel, versionsForFamily } from "../../data/mock-ps5";
import type { Edition } from "../../data/mock-ps5";
import { consoleImageAlts } from "../../data/console-images";
import { getLiveVariant } from "../../lib/live-data";

// ─────────────────────────────────────────────────────────────────────────
// Données structurées Product / AggregateOffer
//
// Tant que les prix affichés sont des DONNÉES DE DÉMONSTRATION, on ne les
// publie PAS en JSON-LD : Google les lirait comme de vraies offres, ce qui est
// trompeur (et un Product sans offre ni avis n'est de toute façon pas exploitable
// par Google). Seul le fil d'Ariane (BreadcrumbList), sans prix, est publié.
// → Passer à `false` UNIQUEMENT quand les prix viennent d'une vraie source :
//   un Product avec AggregateOffer est alors publié pour chaque configuration.
// ─────────────────────────────────────────────────────────────────────────
const PRICES_ARE_DEMO = true;

const family = getFamily(Astro.params.family ?? "");
if (!family) {
  return new Response(null, { status: 404 });
}

// Les données internes restent organisées par configuration (état × version) :
// seule la navigation change. La PS5 Pro n'a qu'une référence (pas de version
// "avec lecteur" distincte) : on ne génère donc que les configurations réelles.
const editions: Edition[] = ["neuf", "reconditionne"];
const editionLabels: Record<Edition, string> = { neuf: "Neuf", reconditionne: "Reconditionné" };
const versions = versionsForFamily(family.slug);
const hasMultipleVersions = versions.length > 1;

const loaded = await Promise.all(
  editions.flatMap((edition) =>
    versions.map(async (version) => ({
      edition,
      version,
      variant: await getLiveVariant(family.slug, edition, version),
    }))
  )
);

const configs = loaded.flatMap(({ edition, version, variant }) => {
  if (!variant) return [];

  const editionLabel = editionLabels[edition];
  const sortedMerchants = [...variant.merchants].sort((a, b) => a.price - b.price);
  // Meilleure offre = marchand réellement disponible (repli sur tous si aucun
  // n'est en stock), comme dans le calcul de currentPrice (live-data.ts).
  const best = sortedMerchants.find((m) => m.available) ?? sortedMerchants[0];
  const mostRecentUpdate = [...variant.merchants].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))[0]?.updatedAt;

  return [
    {
      id: `${edition}-${version}`, // ancre : /ps5/ps5#neuf-digital
      edition,
      version,
      variant,
      // Libellés identiques à ceux des anciennes pages (utilisés aussi dans les e-mails d'alerte).
      label: hasMultipleVersions ? `${editionLabel} — ${versionLabel(version)}` : editionLabel,
      heading: hasMultipleVersions
        ? `${family.name} ${editionLabel} — ${versionLabel(version)}`
        : `${family.name} ${editionLabel}`,
      modelName: `${family.name} ${editionLabel}${hasMultipleVersions ? ` ${versionLabel(version)}` : ""}`,
      sortedMerchants,
      best,
      updatedLabel: mostRecentUpdate
        ? new Date(mostRecentUpdate).toLocaleDateString("fr-FR", { day: "numeric", month: "long" })
        : null,
    },
  ];
});

if (configs.length === 0) {
  return new Response(null, { status: 404 });
}

const cheapest = configs.reduce((min, c) => (c.variant.currentPrice < min.variant.currentPrice ? c : min));

const alertConfigs = configs.map((c) => ({
  edition: c.edition,
  version: c.version,
  label: c.label,
  modelName: c.modelName,
  price: c.variant.currentPrice,
}));

// Sélecteurs État / Version : uniquement ce qui existe réellement dans les données
// (la PS5 Pro n'a pas de version « Avec lecteur » → pas de groupe Version).
// Configuration affichée par défaut = celle déjà utilisée comme meilleur prix
// (`cheapest`, la même que « À partir de » dans le haut de page).
const defaultConfig = cheapest;
const availableEditions = editions.filter((e) => configs.some((c) => c.edition === e));
const availableVersions = versions.filter((v) => configs.some((c) => c.version === v));

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: "https://tracko-ps5.netlify.app/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: family.name,
    },
  ],
};

const productJsonLd = configs.map((c) => {
  const prices = c.variant.merchants.map((m) => m.price);
  return {
    "@context": "https://schema.org",
    "@type": "Product",
    name: c.modelName,
    description: `${family.tagline} Édition ${editionLabels[c.edition].toLowerCase()}${hasMultipleVersions ? `, version ${versionLabel(c.version).toLowerCase()}` : ""}.`,
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "EUR",
      lowPrice: Math.min(...prices),
      highPrice: Math.max(...prices),
      offerCount: c.variant.merchants.length,
      offers: c.variant.merchants.map((m) => ({
        "@type": "Offer",
        price: m.price,
        priceCurrency: "EUR",
        availability: m.available ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
        url: m.url,
        seller: { "@type": "Organization", name: m.name },
      })),
    },
  };
});

const jsonLd = PRICES_ARE_DEMO ? [breadcrumbJsonLd] : [breadcrumbJsonLd, ...productJsonLd];
---

<Layout
  title={`${family.name} : prix et offres, neuf et reconditionné | Tracko`}
  description={`Compare les offres de la ${family.name} chez les marchands français : neuf et reconditionné${hasMultipleVersions ? ", Digital ou avec lecteur" : ""}. Crée une alerte de prix.`}
  jsonLd={jsonLd}
>
  <div class="container family-page">
    <a href="/" class="back-link">
      <span class="back-link__arrow">←</span>
      <span>Tous les modèles</span>
    </a>

    <section class="family-hero fade-in">
      <div class="family-hero__visual">
        <div class="family-hero__halo" aria-hidden="true"></div>
        <div class="family-hero__console">
          <ConsoleIllustration
            slug={family.slug}
            size={88}
            alt={consoleImageAlts[family.slug]}
            loading="eager"
          />
        </div>
      </div>

      <div class="family-hero__content">
        <span class="family-hero__eyebrow">PlayStation 5</span>
        <h1>{family.name}</h1>
        <p>{family.tagline}</p>
        <p class="family-hero__from">
          À partir de <strong>{cheapest.variant.currentPrice} €</strong> · {cheapest.label}
        </p>
      </div>
    </section>

    <section class="config-picker card fade-in" data-config-picker aria-label="Choisir la configuration">
      {availableEditions.length > 1 && (
        <div class="choice-group" role="group" aria-labelledby="choice-edition-label">
          <span class="choice-group__label" id="choice-edition-label">État</span>
          <div class="choice-group__options">
            {availableEditions.map((e) => (
              <button
                type="button"
                class="choice"
                data-choice="edition"
                data-value={e}
                aria-pressed={e === defaultConfig.edition ? "true" : "false"}
              >
                {editionLabels[e]}
              </button>
            ))}
          </div>
        </div>
      )}

      {availableVersions.length > 1 && (
        <div class="choice-group" role="group" aria-labelledby="choice-version-label">
          <span class="choice-group__label" id="choice-version-label">Version</span>
          <div class="choice-group__options">
            {availableVersions.map((v) => (
              <button
                type="button"
                class="choice"
                data-choice="version"
                data-value={v}
                aria-pressed={v === defaultConfig.version ? "true" : "false"}
              >
                {versionLabel(v)}
              </button>
            ))}
          </div>
        </div>
      )}
    </section>

    {configs.map((c) => (
      <section
        class="config-section"
        data-config-panel
        data-config-id={c.id}
        data-edition={c.edition}
        data-version={c.version}
        data-label={c.label}
        data-model-name={c.modelName}
        data-price={c.variant.currentPrice}
        hidden={c.id !== defaultConfig.id}
      >
        <div class="config-section__header">
          <h2>{c.heading}</h2>
          <div class="config-section__meta">
            <span>À partir de <strong>{c.variant.currentPrice} €</strong></span>
            <span class={`badge badge--${c.variant.priceLevel}`}>{priceLevelLabel(c.variant.priceLevel)}</span>
          </div>
        </div>

        {c.updatedLabel && <p class="config-section__updated">Mis à jour le {c.updatedLabel}</p>}

        <div class="card merchant-list">
          {c.sortedMerchants.map((merchant) => (
            <MerchantRow merchant={merchant} isBest={merchant.id === c.best.id} />
          ))}
        </div>

        <a class="config-section__alert" href="#alerte">
          Être alerté pour cette configuration
        </a>
      </section>
    ))}

    <section class="config-section config-section--alert" id="alerte">
      <AlertForm
        modelName={defaultConfig.modelName}
        currentPrice={defaultConfig.variant.currentPrice}
        familySlug={family.slug}
        edition={defaultConfig.edition}
        version={defaultConfig.version}
        configs={alertConfigs}
        followSelection
      />
    </section>
  </div>
</Layout>

<script>
  // Sélecteurs État / Version : affichent le panneau de la configuration choisie
  // (un seul visible à la fois). Le formulaire d'alerte (AlertForm) relit le
  // panneau visible quand il reçoit `tracko:config-change`.
  const picker = document.querySelector<HTMLElement>("[data-config-picker]");
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-config-panel]"));

  if (picker && panels.length > 0) {
    type ChoiceKey = "edition" | "version";
    const buttons = Array.from(picker.querySelectorAll<HTMLButtonElement>("[data-choice]"));

    const current = () => panels.find((p) => !p.hidden);

    const show = (panel: HTMLElement) => {
      panels.forEach((p) => {
        p.hidden = p !== panel;
      });
      buttons.forEach((b) => {
        const key = b.dataset.choice as ChoiceKey;
        b.setAttribute("aria-pressed", String(b.dataset.value === panel.dataset[key]));
      });
      document.dispatchEvent(new CustomEvent("tracko:config-change"));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const active = current();
        const key = button.dataset.choice as ChoiceKey;
        if (!active) return;

        const other: ChoiceKey = key === "edition" ? "version" : "edition";
        // On garde l'autre choix si la combinaison existe, sinon on prend la
        // première configuration réellement disponible pour cette valeur.
        const target =
          panels.find((p) => p.dataset[key] === button.dataset.value && p.dataset[other] === active.dataset[other]) ??
          panels.find((p) => p.dataset[key] === button.dataset.value);

        if (!target || target === active) return;

        show(target);
        history.replaceState(null, "", `#${target.dataset.configId}`);
      });
    });

    // Anciennes URLs (/ps5/ps5/neuf/digital → 301 → /ps5/ps5#neuf-digital) :
    // le hash présélectionne la bonne configuration.
    const fromHash = panels.find((p) => p.dataset.configId === location.hash.slice(1));
    if (fromHash && fromHash !== current()) show(fromHash);
  }
</script>

<style>
  .family-page {
    max-width: 720px;
    padding: 28px 24px 72px;
  }

  /* ─────────────────────────────────────────
     RETOUR
  ───────────────────────────────────────── */

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin-bottom: 30px;
    color: var(--color-text-secondary);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--dur-fast) ease,
      transform var(--dur-fast) ease;
  }

  .back-link:hover {
    color: var(--color-text-primary);
    transform: translateX(-2px);
  }

  .back-link__arrow {
    font-size: 17px;
    line-height: 1;
  }

  /* ─────────────────────────────────────────
     HERO PS5
  ───────────────────────────────────────── */

  .family-hero {
    position: relative;
    display: grid;
    grid-template-columns: 190px 1fr;
    align-items: center;
    gap: 34px;
    min-height: 190px;
    margin-bottom: 34px;
    padding: 24px 28px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(247, 248, 252, 0.96) 100%
      );
    box-shadow:
      0 12px 34px rgba(25, 31, 50, 0.055),
      0 2px 8px rgba(25, 31, 50, 0.035);
  }

  .family-hero::after {
    content: "";
    position: absolute;
    right: -90px;
    top: -110px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: rgba(72, 105, 214, 0.065);
    filter: blur(4px);
    pointer-events: none;
  }

  .family-hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 150px;
  }

  .family-hero__halo {
    position: absolute;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: var(--color-accent-blue-soft);
  }

  .family-hero__console {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: scale(1.08);
  }

  .family-hero__content {
    position: relative;
    z-index: 1;
  }

  .family-hero__eyebrow {
    display: block;
    margin-bottom: 7px;
    color: var(--color-accent-blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .family-hero__content h1 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(36px, 6vw, 50px);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .family-hero__content p {
    max-width: 390px;
    margin: 11px 0 0;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  .family-hero__content .family-hero__from {
    max-width: none;
    margin-top: 14px;
    color: var(--color-text-secondary);
    font-size: 13px;
  }

  .family-hero__from strong {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  /* ─────────────────────────────────────────
     SÉLECTEURS : ÉTAT / VERSION
  ───────────────────────────────────────── */

  .config-picker {
    display: grid;
    gap: 20px;
    padding: 22px;
  }

  .choice-group {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .choice-group__label {
    color: var(--color-text-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .choice-group__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .choice {
    min-width: 0;
    min-height: 52px;
    padding: 10px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: 14px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-align: center;
    cursor: pointer;
    transition:
      background var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }

  .choice:hover {
    border-color: var(--color-text-muted);
    background: var(--color-surface-muted);
  }

  .choice:focus-visible {
    outline: 2px solid var(--color-accent-blue);
    outline-offset: 2px;
  }

  .choice[aria-pressed="true"],
  .choice[aria-pressed="true"]:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-text);
    box-shadow: 0 8px 18px rgba(27, 42, 74, 0.2);
  }

  /* ─────────────────────────────────────────
     OFFRES PAR CONFIGURATION
  ───────────────────────────────────────── */

  .config-section {
    margin-top: 28px;
    scroll-margin-top: 20px;
  }

  .config-section[data-config-panel]:not([hidden]) {
    animation: config-panel-in 220ms ease both;
  }

  .config-section--alert {
    margin-top: 44px;
  }

  @keyframes config-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .config-section__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
    margin-bottom: 4px;
  }

  .config-section__header h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .config-section__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-secondary);
    font-size: 13px;
  }

  .config-section__meta strong {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .config-section__updated {
    margin: 0 0 12px;
    color: var(--color-text-muted);
    font-size: 12px;
  }

  .merchant-list {
    overflow: hidden;
  }

  .config-section__alert {
    display: inline-block;
    margin-top: 12px;
    color: var(--color-accent-blue);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .config-section__alert:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ─────────────────────────────────────────
     MOBILE
  ───────────────────────────────────────── */

  @media (max-width: 640px) {
    .family-page {
      padding: 22px 16px 54px;
    }

    .back-link {
      margin-bottom: 24px;
    }

    .family-hero {
      grid-template-columns: 1fr;
      gap: 14px;
      min-height: 0;
      margin-bottom: 28px;
      padding: 24px 20px 25px;
      text-align: center;
    }

    .family-hero__visual {
      height: 118px;
    }

    .family-hero__halo {
      width: 108px;
      height: 108px;
    }

    .family-hero__console {
      transform: scale(0.98);
    }

    .family-hero__content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .family-hero__content h1 {
      font-size: 38px;
    }

    .family-hero__content p {
      max-width: 330px;
      font-size: 13px;
    }

    .config-picker {
      gap: 18px;
      padding: 16px;
    }

    .choice-group__options {
      gap: 8px;
    }

    .choice {
      min-height: 50px;
      padding: 10px 8px;
      font-size: 14px;
    }

    .config-section {
      margin-top: 24px;
    }

    .config-section--alert {
      margin-top: 36px;
    }

    .config-section__header h2 {
      font-size: 18px;
    }
  }

  @media (max-width: 380px) {
    .family-hero {
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .choice {
      transition: none;
    }

    .config-section[data-config-panel]:not([hidden]) {
      animation: none;
    }
  }
</style>
