---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Mes alertes — Tracko"
  description="Retrouve toutes tes alertes de prix PS5."
>
  <div class="container empty-state">
    <h1>Mes alertes</h1>
    <p>Tu n'as pas encore créé d'alerte. Choisis une PS5 pour en créer une.</p>
    <a href="/#selection" class="button button--primary">Voir les modèles</a>
  </div>
</Layout>

<style>
  .empty-state {
    padding: 64px 24px;
    text-align: center;
    max-width: 420px;
    margin: 0 auto;
  }

  .empty-state h1 {
    font-size: 22px;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
  }
</style>
