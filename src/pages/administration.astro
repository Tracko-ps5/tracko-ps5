---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { isValidSession, ADMIN_SESSION_COOKIE } from "../lib/admin-auth";
import { getEditableSnapshot } from "../lib/live-data";
import { getFamily, versionsForFamily, versionLabel } from "../data/mock-ps5";
import type { Version } from "../data/mock-ps5";

const session = Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value;
const authenticated = isValidSession(session);

const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved");

const errorMessages: Record<string, string> = {
  code: "Code incorrect.",
  session: "Ta session a expiré, reconnecte-toi.",
  json: "Le texte collé n'est pas un JSON valide.",
  shape: "Le JSON ne correspond pas au format attendu (vérifie les champs de chaque marchand).",
  values: "Une valeur est invalide : prix ≤ 0, note de confiance hors de 1 à 5, ou lien qui ne commence pas par http(s)://.",
  storage: "L'enregistrement a échoué (problème de connexion au stockage). Réessaie dans un instant.",
};

let snapshotJson = "";
let products: {
  key: string;
  label: string;
  merchants: { id: string; name: string; price: number }[];
}[] = [];

if (authenticated) {
  const snapshot = await getEditableSnapshot();
  snapshotJson = JSON.stringify(snapshot, null, 2);

  products = Object.entries(snapshot).map(([key, entry]) => {
    const [familySlug, edition, version] = key.split(":");
    const family = getFamily(familySlug);
    const editionLabel = edition === "neuf" ? "Neuf" : "Reconditionné";
    const hasMultipleVersions = family ? versionsForFamily(family.slug).length > 1 : true;
    const versionSuffix = hasMultipleVersions ? ` ${versionLabel(version as Version)}` : "";
    const label = `${family?.name ?? familySlug} — ${editionLabel}${versionSuffix}`;

    return {
      key,
      label,
      merchants: entry.merchants.map((m) => ({ id: m.id, name: m.name, price: m.price })),
    };
  });
}
---

<Layout title="Administration — Tracko" description="Espace d'administration Tracko.">
  <div class="container admin">
    {!authenticated && (
      <div class="admin__login">
        <h1>Administration</h1>
        <p class="admin__hint">Entre le code d'accès pour mettre à jour les prix du site.</p>
        {error === "code" && <p class="admin__error">Code incorrect.</p>}
        <form method="POST" action="/api/admin/login" class="admin__form">
          <input type="password" name="code" placeholder="Code d'accès" required autofocus />
          <button type="submit" class="button button--primary">Se connecter</button>
        </form>
      </div>
    )}

    {authenticated && (
      <div class="admin__panel">
        <div class="admin__header">
          <h1>Administration</h1>
          <form method="POST" action="/api/admin/logout">
            <button type="submit" class="button">Se déconnecter</button>
          </form>
        </div>

        {saved === "1" && <p class="admin__success">Enregistré — le site affiche maintenant ces données.</p>}
        {error && errorMessages[error] && <p class="admin__error">{errorMessages[error]}</p>}

        <p class="admin__hint">Clique sur un prix pour le modifier. Chaque modification est enregistrée immédiatement et visible tout de suite sur le site public.</p>

        <div class="admin-products">
          {products.map((product) => (
            <div class="admin-product" data-key={product.key}>
              <h3 class="admin-product__title">{product.label}</h3>

              <ul class="admin-product__merchants">
                {product.merchants.map((m) => (
                  <li class="admin-merchant" data-merchant={m.id}>
                    <span class="admin-merchant__name">{m.name}</span>

                    <span class="admin-merchant__price-wrap">
                      <button type="button" class="admin-merchant__price-display">
                        {m.price.toFixed(2).replace(".", ",")} €
                      </button>

                      <input
                        type="number"
                        step="0.01"
                        min="0.01"
                        class="admin-merchant__price-input"
                        value={m.price}
                        hidden
                      />

                      <button type="button" class="admin-merchant__save-btn button button--primary" hidden>
                        Enregistrer
                      </button>
                      <button type="button" class="admin-merchant__cancel-btn button" hidden>
                        Annuler
                      </button>
                    </span>

                    <span class="admin-merchant__status" aria-live="polite"></span>

                    <button
                      type="button"
                      class="admin-merchant__remove-btn"
                      title={`Supprimer la référence ${m.name}`}
                      aria-label={`Supprimer la référence ${m.name}`}
                    >
                      ×
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <details class="admin-advanced">
          <summary>Mode avancé (JSON complet)</summary>

          <div class="admin__instructions">
            <p><strong>Comment ça marche :</strong> le texte ci-dessous contient tous les modèles, éditions et marchands actuellement affichés sur le site. Modifie les prix, passe <code>available</code> à <code>false</code> pour une rupture de stock, ajoute ou retire un objet marchand dans la liste — puis clique sur Enregistrer. Le site public est mis à jour immédiatement, sans reconstruction.</p>
            <p>Clé de chaque bloc : <code>famille:édition:version</code> — éditions : <code>neuf</code> / <code>reconditionne</code> ; versions : <code>digital</code> / <code>lecteur</code>. Exception : la <code>ps5-pro</code> n'a qu'une seule référence (<code>digital</code> uniquement) — pas de clé <code>ps5-pro:*:lecteur</code>, un lecteur externe reste une offre/bundle chez un marchand, pas une version à part.</p>
            <p><code>averagePrice</code> est le prix de référence utilisé pour calculer le badge affiché ("Bon prix", "Excellent prix", "Prix élevé"...). Renseigne-le avec le vrai prix moyen que tu observes chez les marchands — sinon le badge reste basé sur une moyenne de démonstration, pas une vraie donnée de marché.</p>
            <p>Contraintes : <code>price</code> et <code>averagePrice</code> doivent être supérieurs à 0, <code>trustRating</code> entre 1 et 5, <code>url</code> doit commencer par <code>http://</code> ou <code>https://</code>.</p>
          </div>

          <form method="POST" action="/api/admin/save" class="admin__form">
            <textarea name="payload" class="admin__textarea" spellcheck="false">{snapshotJson}</textarea>
            <button type="submit" class="button button--primary">Enregistrer et publier</button>
          </form>
        </details>
      </div>
    )}
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".admin-merchant").forEach((row) => {
    const product = row.closest<HTMLElement>(".admin-product");
    const key = product?.dataset.key;
    const merchantId = row.dataset.merchant;

    const display = row.querySelector<HTMLButtonElement>(".admin-merchant__price-display");
    const input = row.querySelector<HTMLInputElement>(".admin-merchant__price-input");
    const saveBtn = row.querySelector<HTMLButtonElement>(".admin-merchant__save-btn");
    const cancelBtn = row.querySelector<HTMLButtonElement>(".admin-merchant__cancel-btn");
    const status = row.querySelector<HTMLElement>(".admin-merchant__status");
    const removeBtn = row.querySelector<HTMLButtonElement>(".admin-merchant__remove-btn");

    if (!display || !input || !saveBtn || !cancelBtn || !status || !key || !merchantId) return;

    const startEdit = () => {
      status.textContent = "";
      display.hidden = true;
      input.hidden = false;
      saveBtn.hidden = false;
      cancelBtn.hidden = false;
      input.focus();
      input.select();
    };

    const stopEdit = () => {
      display.hidden = false;
      input.hidden = true;
      saveBtn.hidden = true;
      cancelBtn.hidden = true;
    };

    display.addEventListener("click", startEdit);

    cancelBtn.addEventListener("click", () => {
      input.value = String(parseFloat(display.textContent?.replace(",", ".").replace("€", "").trim() || "0"));
      stopEdit();
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") saveBtn.click();
      if (e.key === "Escape") cancelBtn.click();
    });

    saveBtn.addEventListener("click", async () => {
      const price = parseFloat(input.value.replace(",", "."));
      if (!Number.isFinite(price) || price <= 0) {
        status.textContent = "Prix invalide.";
        status.style.color = "var(--color-tres-cher-text)";
        return;
      }

      saveBtn.disabled = true;
      status.textContent = "Enregistrement…";
      status.style.color = "";

      try {
        const response = await fetch("/api/admin/update-price", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ key, merchantId, price }),
        });

        if (!response.ok) throw new Error();

        display.textContent = `${price.toFixed(2).replace(".", ",")} €`;
        status.textContent = "✓ Enregistré";
        status.style.color = "var(--color-excellent-text)";
        stopEdit();
      } catch {
        status.textContent = "Échec de l'enregistrement — réessaie.";
        status.style.color = "var(--color-tres-cher-text)";
      } finally {
        saveBtn.disabled = false;
      }
    });

    removeBtn?.addEventListener("click", async () => {
      const merchantName = row.querySelector(".admin-merchant__name")?.textContent?.trim() ?? merchantId;
      const productTitle = product?.querySelector(".admin-product__title")?.textContent?.trim() ?? key;

      if (!window.confirm(`Supprimer la référence ${merchantName} pour « ${productTitle} » ?`)) return;

      removeBtn.disabled = true;
      status.textContent = "Suppression…";
      status.style.color = "";

      try {
        const response = await fetch("/api/admin/remove-price", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ key, merchantId }),
        });

        if (response.status === 409) {
          status.textContent = "Impossible : dernier marchand de ce produit.";
          status.style.color = "var(--color-tres-cher-text)";
          removeBtn.disabled = false;
          return;
        }

        if (!response.ok) throw new Error();

        status.textContent = "✓ Supprimé";
        status.style.color = "var(--color-excellent-text)";
        row.classList.add("admin-merchant--removed");

        // Laisse la confirmation visible un instant, puis retire la ligne.
        window.setTimeout(() => row.remove(), 900);
      } catch {
        status.textContent = "Échec de la suppression — réessaie.";
        status.style.color = "var(--color-tres-cher-text)";
        removeBtn.disabled = false;
      }
    });
  });
</script>

<style>
  .admin {
    padding: 48px 24px 80px;
    max-width: 720px;
  }

  .admin__login {
    max-width: 320px;
    margin: 60px auto 0;
    text-align: center;
  }

  .admin__hint {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin: 8px 0 20px;
  }

  .admin__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .admin__form input {
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
  }

  .admin__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .admin__success {
    background: var(--color-excellent-bg);
    color: var(--color-excellent-text);
    padding: 10px 14px;
    border-radius: var(--radius-control);
    font-size: 13px;
    margin-bottom: 16px;
  }

  .admin__error {
    background: var(--color-tres-cher-bg);
    color: var(--color-tres-cher-text);
    padding: 10px 14px;
    border-radius: var(--radius-control);
    font-size: 13px;
    margin-bottom: 16px;
  }

  .admin-products {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .admin-product {
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    padding: 14px 16px;
    background: var(--color-surface);
  }

  .admin-product__title {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 10px;
  }

  .admin-product__merchants {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .admin-merchant {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    padding: 6px 0;
    border-top: 0.5px solid var(--color-border);
  }

  .admin-product__merchants li:first-child {
    border-top: none;
  }

  .admin-merchant__name {
    flex: 1;
    color: var(--color-text-secondary);
  }

  .admin-merchant__price-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .admin-merchant__price-display {
    font-family: inherit;
    font-size: 13px;
    font-weight: 650;
    color: var(--color-text-primary);
    background: var(--color-surface-muted);
    border: 0.5px solid transparent;
    border-radius: var(--radius-control);
    padding: 5px 10px;
    cursor: pointer;
  }

  .admin-merchant__price-display:hover {
    border-color: var(--color-border-strong);
  }

  .admin-merchant__price-input {
    width: 90px;
    font-family: inherit;
    font-size: 13px;
    padding: 5px 8px;
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
  }

  .admin-merchant__status {
    font-size: 11.5px;
    min-width: 90px;
    text-align: right;
  }

  .admin-merchant__remove-btn {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-family: inherit;
    font-size: 18px;
    line-height: 1;
    color: #d64545;
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-premium);
  }

  .admin-merchant__remove-btn:hover:not(:disabled) {
    background: rgba(214, 69, 69, 0.12);
  }

  .admin-merchant__remove-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .admin-merchant--removed {
    opacity: 0.5;
    transition: opacity 600ms ease;
  }

  .admin-advanced {
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    padding: 14px 16px;
  }

  .admin-advanced summary {
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }

  .admin-advanced[open] summary {
    margin-bottom: 14px;
  }

  .admin__instructions {
    font-size: 13px;
    color: var(--color-text-secondary);
    background: var(--color-surface-muted);
    border-radius: var(--radius-control);
    padding: 14px 16px;
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .admin__instructions code {
    background: var(--color-surface);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12px;
  }

  .admin__textarea {
    width: 100%;
    min-height: 420px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 12.5px;
    line-height: 1.5;
    padding: 14px;
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-text-primary);
    resize: vertical;
  }
</style>
