---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import FamilyCard from "../components/FamilyCard.astro";
import CountdownBanner from "../components/CountdownBanner.astro";
import { families, versionsForFamily } from "../data/mock-ps5";
import { getLiveVariant } from "../lib/live-data";

const familyVariants = await Promise.all(
  families.map(async (family) => {
    const hasLecteur = versionsForFamily(family.slug).includes("lecteur");
    return {
      family,
      variants: {
        neuf: {
          digital: (await getLiveVariant(family.slug, "neuf", "digital"))!,
          lecteur: hasLecteur ? await getLiveVariant(family.slug, "neuf", "lecteur") : undefined,
        },
        reconditionne: {
          digital: (await getLiveVariant(family.slug, "reconditionne", "digital"))!,
          lecteur: hasLecteur ? await getLiveVariant(family.slug, "reconditionne", "lecteur") : undefined,
        },
      },
    };
  })
);
---

<Layout
  title="Tracko — Trouve ta PS5 au meilleur prix"
  description="Compare les prix, suis leur évolution et sois alerté dès qu'une bonne affaire apparaît sur la PlayStation 5."
>
  <div class="hero-wrap" id="hero-wrap">
    <div class="hero-wrap__inner">
      <section class="hero">
        <div class="container hero__inner">
          <p class="hero__kicker">
            <span class="hero__kicker-dot" aria-hidden="true"></span>
            Comparateur PS5 indépendant
          </p>

          <h1 class="hero__title">
            Trouve le bon prix.
            <span>Choisis ta PS5.</span>
          </h1>

          <p class="hero__subtitle">
            Compare les prix actuels et repère les meilleures offres en un coup d'œil.
          </p>

          <button
            type="button"
            class="button button--primary hero__cta"
            id="start-button"
          >
            Voir les PS5
            <span class="hero__cta-arrow" aria-hidden="true">↓</span>
          </button>
        </div>
      </section>
    </div>
  </div>

  <section class="selection" id="selection" data-edition-selected="neuf">
    <div class="container">
      <div class="selection__intro">
        <div>
          <p class="selection__eyebrow">
            <span class="selection__eyebrow-mark" aria-hidden="true"></span>
            Les modèles
          </p>

          <h2 class="selection__title">
            Choisis ta PS5
          </h2>
        </div>

        <div
          class="edition-toggle"
          id="edition-toggle"
          role="group"
          aria-label="Neuf ou reconditionné"
        >
          <button
            type="button"
            class="edition-toggle__btn is-active"
            data-edition="neuf"
          >
            Neuf
          </button>

          <button
            type="button"
            class="edition-toggle__btn"
            data-edition="reconditionne"
          >
            Reconditionné
          </button>
        </div>
      </div>

      <div class="family-grid" id="family-grid">
        {familyVariants.map(({ family, variants }, i) => (
          <FamilyCard family={family} variants={variants} index={i} />
        ))}
      </div>

      <div class="banner-wrap">
        <CountdownBanner />
      </div>
    </div>
  </section>
</Layout>

<script>
  const startButton = document.getElementById("start-button");
  const heroWrap = document.getElementById("hero-wrap");
  const selection = document.getElementById("selection");
  const grid = document.getElementById("family-grid");
  const editionToggle = document.getElementById("edition-toggle");

  const cards = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".family-card")
  );

  let unlocked = false;

  grid?.classList.add("is-locked");
  selection?.classList.add("is-locked");

  cards.forEach((card) => {
    card.setAttribute("tabindex", "-1");

    card.addEventListener("click", (e) => {
      if (!unlocked) {
        e.preventDefault();
      }
    });
  });

  editionToggle
    ?.querySelectorAll<HTMLButtonElement>(".edition-toggle__btn")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const edition = btn.dataset.edition;

        if (!edition || !selection) return;

        selection.setAttribute("data-edition-selected", edition);

        editionToggle
          .querySelectorAll(".edition-toggle__btn")
          .forEach((b) => b.classList.remove("is-active"));

        btn.classList.add("is-active");
      });
    });

  startButton?.addEventListener("click", () => {
    if (unlocked || !grid) return;

    unlocked = true;

    heroWrap?.classList.add("is-collapsed");

    const firstRects = cards.map((c) => c.getBoundingClientRect());

    grid.classList.remove("is-locked");
    grid.classList.add("is-unlocked");

    selection?.classList.remove("is-locked");
    selection?.classList.add("is-unlocked");

    cards.forEach((card) => {
      card.removeAttribute("tabindex");
    });

    const lastRects = cards.map((c) => c.getBoundingClientRect());

    cards.forEach((card, i) => {
      const first = firstRects[i];
      const last = lastRects[i];

      const dx = first.left - last.left;
      const dy = first.top - last.top;
      const sx = first.width / last.width;
      const sy = first.height / last.height;

      card.style.transformOrigin = "top left";
      card.style.transition = "none";
      card.style.transform =
        `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;

      requestAnimationFrame(() => {
        card.style.transition =
          "transform 650ms cubic-bezier(0.22, 1, 0.36, 1)";
        card.style.transform =
          "translate(0, 0) scale(1, 1)";
      });
    });

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });
</script>

<style>
  /* ========================================
     HERO
     ======================================== */

  .hero-wrap {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 480ms var(--ease-premium);
  }

  .hero-wrap__inner {
    overflow: hidden;
  }

  .hero-wrap.is-collapsed {
    grid-template-rows: 0fr;
  }

  .hero-wrap.is-collapsed .hero {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 180ms ease,
      transform 220ms var(--ease-premium);
  }

  .hero {
    position: relative;
    isolation: isolate;

    padding: 74px 24px 54px;

    text-align: center;

    opacity: 1;
    transform: translateY(0);

    transition:
      opacity 220ms ease 120ms,
      transform 420ms var(--ease-premium);
  }

  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;

    width: 420px;
    height: 280px;

    left: 50%;
    top: 35px;

    transform: translateX(-50%);

    background:
      radial-gradient(
        circle,
        rgba(72, 105, 214, 0.11) 0%,
        rgba(72, 105, 214, 0.045) 38%,
        transparent 72%
      );

    pointer-events: none;
  }

  .hero__inner {
    max-width: 700px;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    margin: 0 auto 18px;

    font-size: 11px;
    font-weight: 600;
    line-height: 1;

    text-transform: uppercase;
    letter-spacing: 0.12em;

    color: var(--color-accent);
  }

  .hero__kicker-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: var(--color-accent-blue);

    box-shadow:
      0 0 0 4px var(--color-accent-blue-soft);
  }

  .hero__title {
    max-width: 680px;

    margin: 0 auto;

    font-family: var(--font-display);

    font-size: clamp(42px, 7vw, 64px);
    font-weight: 650;
    line-height: 0.98;

    letter-spacing: -0.055em;

    color: var(--color-text-primary);
  }

  .hero__title span {
    display: block;

    margin-top: 5px;

    background: linear-gradient(
      110deg,
      var(--color-accent) 0%,
      var(--color-accent-blue) 100%
    );

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    max-width: 480px;

    margin: 24px auto 30px;

    font-size: 15px;
    line-height: 1.55;

    letter-spacing: -0.005em;

    color: var(--color-text-secondary);
  }

  .hero__cta {
    min-height: 48px;

    padding: 13px 22px 13px 24px;

    border: 1px solid var(--color-accent);

    border-radius: 999px;

    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;

    box-shadow:
      0 8px 20px -12px rgba(27, 42, 74, 0.5),
      0 0 0 0 rgba(72, 105, 214, 0);

    transition:
      background var(--dur-fast) var(--ease-premium),
      transform var(--dur-fast) var(--ease-premium),
      box-shadow var(--dur-fast) var(--ease-premium);
  }

  .hero__cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 20px;
    height: 20px;

    margin-left: 3px;

    border-radius: 50%;

    background: rgba(250, 249, 246, 0.13);

    font-size: 13px;
    line-height: 1;
  }

  .hero__cta:hover {
    transform: translateY(-2px);

    box-shadow:
      0 12px 26px -12px rgba(27, 42, 74, 0.58),
      0 8px 24px -18px rgba(72, 105, 214, 0.7);
  }

  .hero__cta:active {
    transform: scale(0.97);
  }

  /* ========================================
     SELECTION
     ======================================== */

  .selection {
    position: relative;

    padding: 6px 0 64px;
  }

  .selection__intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 24px;

    margin-bottom: 20px;
  }

  .selection__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;

    margin: 0 0 6px;

    font-size: 10px;
    font-weight: 600;
    line-height: 1;

    text-transform: uppercase;
    letter-spacing: 0.1em;

    color: var(--color-text-muted);
  }

  .selection__eyebrow-mark {
    width: 14px;
    height: 2px;

    flex-shrink: 0;

    border-radius: 999px;

    background: linear-gradient(
      90deg,
      var(--color-accent-blue),
      var(--color-accent)
    );
  }

  .selection__title {
    margin: 0;

    font-family: var(--font-display);

    font-size: 25px;
    font-weight: 600;
    line-height: 1.1;

    letter-spacing: -0.035em;

    color: var(--color-text-primary);
  }

  /* ========================================
     EDITION TOGGLE
     ======================================== */

  .edition-toggle {
    display: none;

    gap: 3px;

    padding: 3px;

    width: fit-content;

    border: 1px solid var(--color-border);
    border-radius: 999px;

    background: var(--color-surface-muted);

    margin-bottom: 1px;
  }

  .selection.is-unlocked .edition-toggle {
    display: flex;
  }

  .edition-toggle__btn {
    min-height: 30px;

    padding: 6px 13px;

    border: none;
    border-radius: 999px;

    background: transparent;

    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 500;

    color: var(--color-text-secondary);

    cursor: pointer;

    transition:
      background var(--dur-fast) var(--ease-premium),
      color var(--dur-fast) var(--ease-premium),
      box-shadow var(--dur-fast) var(--ease-premium);
  }

  .edition-toggle__btn.is-active {
    background: var(--color-accent);
    color: var(--color-accent-text);

    box-shadow:
      0 3px 9px -5px rgba(27, 42, 74, 0.55);
  }

  /* ========================================
     FAMILY GRID
     ======================================== */

  .family-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;

    gap: 6px;

    position: relative;

    overflow: visible;
  }

  .family-grid.is-unlocked {
    flex-direction: column;

    gap: 14px;

    margin-bottom: 32px;
  }

  /* ========================================
     MODE INITIAL — CARTES PS5
     ======================================== */

  .family-grid.is-locked {
    position: relative;

    z-index: 2;

    overflow: visible;
  }

  .family-grid.is-locked :global(.family-card) {
    flex: 1 1 0;

    min-width: 0;

    flex-direction: column;
    align-items: center;

    text-align: center;

    padding: 16px 2px 12px;

    gap: 8px;

    cursor: default;

    overflow: visible;

    position: relative;

    z-index: 3;
  }

  .family-grid.is-locked :global(.family-card__tagline),
  .family-grid.is-locked :global(.family-card__prices),
  .family-grid.is-locked :global(.family-card__cta) {
    display: none;
  }

  .family-grid.is-locked :global(.family-card__visual) {
    width: 76px;
    height: 110px;

    overflow: visible;

    transform: none;

    transform-origin: center bottom;

    position: relative;

    z-index: 5;
  }

  .family-grid.is-locked
    :global(.family-card__visual .console-illustration) {
    transform: scale(1.35);

    transform-origin: center bottom;
  }

  .family-grid.is-locked
    :global(.family-card:hover .family-card__visual) {
    transform: none;
  }

  .family-grid.is-locked
    :global(.family-card:hover .console-illustration) {
    transform: scale(1.35);
  }

  .family-grid.is-locked :global(.family-card__name) {
    position: relative;

    z-index: 6;

    font-size: 12px;
    font-weight: 500;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    max-width: 100%;
  }

  /* ========================================
     DESKTOP
     ======================================== */

  @media (min-width: 640px) {
    .family-grid.is-locked {
      padding-top: 24px;
      padding-bottom: 28px;
    }

    .family-grid.is-locked :global(.family-card) {
      padding: 20px 20px 24px;
    }

    .family-grid.is-locked :global(.family-card__visual) {
      width: 150px;
      height: 180px;

      overflow: visible;

      transform: none;
    }

    .family-grid.is-locked
      :global(.family-card__visual .console-illustration) {
      transform: scale(2.15);

      transform-origin: center bottom;
    }

    .family-grid.is-locked
      :global(.family-card:hover .console-illustration) {
      transform: scale(2.15);
    }

    .family-grid.is-locked :global(.family-card__name) {
      font-size: 15px;
    }
  }

  /* ========================================
     PETITS ÉCRANS
     ======================================== */

  @media (max-width: 640px) {
    .hero {
      padding: 60px 20px 42px;
    }

    .hero::before {
      width: 300px;
      height: 230px;
      top: 25px;
    }

    .hero__kicker {
      margin-bottom: 15px;

      font-size: 9.5px;
      letter-spacing: 0.1em;
    }

    .hero__title {
      font-size: clamp(34px, 10vw, 46px);

      line-height: 1;

      letter-spacing: -0.05em;
    }

    .hero__subtitle {
      max-width: 350px;

      margin-top: 19px;
      margin-bottom: 25px;

      font-size: 14px;
      line-height: 1.5;
    }

    .hero__cta {
      min-height: 46px;

      padding: 12px 20px 12px 22px;

      font-size: 13.5px;
    }

    .selection {
      padding-top: 4px;
    }

    .selection__intro {
      align-items: flex-start;
      flex-direction: column;

      gap: 12px;

      margin-bottom: 18px;
    }

    .selection__title {
      font-size: 22px;
    }

    .edition-toggle {
      margin-bottom: 0;
    }

    .banner-wrap {
      margin-top: 24px;
    }
  }

  @media (max-width: 420px) {
    .hero {
      padding: 50px 20px 36px;
    }

    .hero__title {
      font-size: 34px;
    }

    .hero__subtitle {
      font-size: 13.5px;
    }

    .selection__title {
      font-size: 21px;
    }

    .family-grid.is-locked
      :global(.family-card__visual) {
      width: 64px;
      height: 94px;
    }

    .family-grid.is-locked
      :global(.family-card__visual .console-illustration) {
      transform: scale(1.18);
    }

    .family-grid.is-locked
      :global(.family-card:hover .console-illustration) {
      transform: scale(1.18);
    }
  }

  /* ========================================
     ACCESSIBILITÉ
     ======================================== */

  .hero__cta:focus-visible,
  .edition-toggle__btn:focus-visible {
    outline: 2px solid var(--color-accent-blue);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wrap,
    .hero,
    .hero__cta {
      transition: none;
    }

    .hero-wrap.is-collapsed .hero {
      transform: none;
    }

    .hero__cta:hover {
      transform: none;
    }
  }

  /* ========================================
     COUNTDOWN
     ======================================== */

  .banner-wrap {
    margin-top: 32px;
  }
</style>