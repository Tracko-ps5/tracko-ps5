# Code d'accès à /administration — choisis quelque chose de long et difficile à deviner.
# Ne JAMAIS committer la vraie valeur : configure-la dans Netlify (Site settings >
# Environment variables), pas dans ce fichier ni dans le code.
ADMIN_CODE=change-moi

# Resend (envoi des emails d'alerte de prix) — clé API et adresse d'expédition,
# à configurer dans Netlify (Site settings > Environment variables).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=alertes@ton-domaine.fr
